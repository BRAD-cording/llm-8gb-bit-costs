\@writefile{lot}{\contentsline {table}{\numberline {10}{\ignorespaces Passkey retrieval over prompts of about 11k tokens, Qwen3-0.6B, five prompts per row. ``grouped'' is KIVI's per-channel keys, per-token values and 128-token residual window; ``ungrouped'' is plain per-channel/per-token rounding. At four bits the task does not separate the schemes; at two bits it separates them completely.}}{12}{table.10}\protected@file@percent }
\newlabel{tab:passkey}{{10}{12}{Passkey retrieval over prompts of about 11k tokens, Qwen3-0.6B, five prompts per row. ``grouped'' is KIVI's per-channel keys, per-token values and 128-token residual window; ``ungrouped'' is plain per-channel/per-token rounding. At four bits the task does not separate the schemes; at two bits it separates them completely}{table.10}{}}
\@writefile{lot}{\contentsline {table}{\numberline {11}{\ignorespaces The strength-matched comparison repeated on the WikiText-2 test set, same window protocol, same code, same calibration discipline. The ordering holds on both models and the margin is \emph  {larger} than on the abstract corpus, so the conclusion does not depend on the corpus.}}{12}{table.11}\protected@file@percent }
\newlabel{tab:wikitext}{{11}{12}{The strength-matched comparison repeated on the WikiText-2 test set, same window protocol, same code, same calibration discipline. The ordering holds on both models and the margin is \emph {larger} than on the abstract corpus, so the conclusion does not depend on the corpus}{table.11}{}}
